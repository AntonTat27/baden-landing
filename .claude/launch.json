{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "go",
      "runtimeArgs": ["-C", "backend", "run", "./cmd/server"],
      "env": { "ADMIN_PASSWORD": "dev", "ADDR": ":8081" },
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "baden-landing", "start"],
      "env": { "BROWSER": "none", "REACT_APP_API_URL": "http://localhost:8081" },
      "port": 3001,
      "autoPort": true
    }
  ]
}
